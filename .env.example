DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# In production, include your deployed domain(s), e.g. evo-hr-backend.vercel.app
# (VERCEL_URL is trusted automatically when set, so you don't need to add
# every preview deployment by hand — just the stable production alias).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: if unset, falls back to local sqlite (db.sqlite3)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# In production, include your deployed domain(s), e.g. evo-hr-backend.vercel.app
# (VERCEL_URL is trusted automatically when set, so you don't need to add
# every preview deployment by hand — just the stable production alias).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: if unset, falls back to local sqlite (db.sqlite3)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth cookie (the refresh token cookie). Defaults are fine for local dev
# (Lax/non-Secure); in production behind HTTPS with a cross-site frontend,
# set both explicitly:
# DJANGO_AUTH_COOKIE_SAMESITE=None
# DJANGO_AUTH_COOKIE_SECURE=True

# Optional: if unset, emails (password reset, demo-request notifications)
# just print to the console instead of sending.
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=apikey
# DJANGO_EMAIL_HOST_PASSWORD=change-me
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=no-reply@evohr.app
# DEMO_REQUEST_NOTIFY_EMAIL=sales@evohr.app
